{
  "name": "dgm-game",
  "private": true,
  "version": "0.1.0",
  "description": "Don't Get Mad! — a hand-drawn family race game (web + Android).",
  "author": "Connect AL",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "android:assets": "npm run build && node tools/android/assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "vitest run --config vitest.sim.config.ts",
    "test:browser": "node tools/browser/run.mjs",
    "guide:shots": "node tools/browser/guide-shots.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.3.0"
  }
}
